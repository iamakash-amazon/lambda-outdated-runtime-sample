# frozen_string_literal: true

source 'https://rubygems.org'

ruby '>= 3.4.0'

# base64, csv and bigdecimal are bundled gems (not default gems) since Ruby 3.4,
# so they must be declared here to be loadable under Bundler.
gem 'base64'
gem 'bigdecimal'
gem 'csv'

group :development do
  gem 'bundler-audit', require: false
  gem 'rubocop', '~> 1.86', require: false
end
